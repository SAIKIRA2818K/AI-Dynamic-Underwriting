# ──────────────────────────────────────────────────────────────
# AI-Driven Dynamic Underwriting System — Environment Variables
# ──────────────────────────────────────────────────────────────

# OpenAI API Key (required for Explanation Agent)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# SQLite Database Path
DATABASE_URL=sqlite:///./underwriting.db

# ML Model Paths (relative to backend/)
RISK_MODEL_PATH=../models/risk_model.pkl
PREPROCESSOR_PATH=../models/preprocessor.joblib
